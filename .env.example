# Copy to .env (never commit .env). The server refuses to start if required values are missing or weak.

# ---- Required ----
# >= 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# >= 16 random characters. Used to HMAC-hash emails, IPs and visitor IDs. Changing it breaks duplicate detection for existing records.
ANALYTICS_SALT=
ADMIN_EMAIL=
# >= 10 characters
ADMIN_PASSWORD=

# ---- Optional ----
# Read-only analyst account (create both or neither)
ANALYST_EMAIL=
ANALYST_PASSWORD=

# MongoDB. If unset, an in-memory store is used (data is lost on restart; not allowed when NODE_ENV=production).
MONGODB_URI=

# Gemini (server-side only). If unset, the Copilot/Content Studio use clearly labelled rule-based/template fallbacks.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=15000

PORT=4000
NODE_ENV=development
# Public URL used when building tagged campaign links
PUBLIC_BASE_URL=http://localhost:4000
# Comma-separated explicit origins allowed for cross-origin API calls (same-origin is always allowed). "*" is rejected.
CORS_ORIGINS=
# Set true only when behind a trusted reverse proxy (so X-Forwarded-For is used for rate limiting)
TRUST_PROXY=false
JWT_TTL_SECONDS=28800
# Campaign timezone offset in minutes from UTC (IST = 330)
TZ_OFFSET_MIN=330
